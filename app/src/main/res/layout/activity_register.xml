<!-- Root container: a vertical layout that centres the registration form on the screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#F3F6FA">

    <!-- ===== HEADER SECTION ===== -->

    <!-- Screen title, centred and bold -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Your Account"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"/>

    <!-- Subtitle explaining the purpose of the app; margins add space above and below -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Join CampusWallet and start managing your student finances."
        android:textColor="#526174"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"/>

    <!-- ===== REGISTRATION FORM FIELDS ===== -->

    <!-- Input for the student's full name -->
    <EditText
        android:id="@+id/studentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Full name"
        android:inputType="textPersonName"
        android:padding="14dp"/>

    <!-- Input for the student's email address; the keyboard shows the @ symbol for easy typing -->
    <EditText
        android:id="@+id/studentEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email address"
        android:inputType="textEmailAddress"
        android:padding="14dp"/>

    <!-- Password input; characters are hidden as the user types. The hint states the minimum length rule -->
    <EditText
        android:id="@+id/studentPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password (at least 6 characters)"
        android:inputType="textPassword"
        android:padding="14dp"/>

    <!-- ===== ACTIONS ===== -->

    <!-- Submits the form to create the new account -->
    <Button
        android:id="@+id/registerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:layout_marginTop="18dp"
        android:backgroundTint="#17365D"/>

    <!-- Link-style text for users who already have an account; clicking it should open the login screen -->
    <TextView
        android:id="@+id/goToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Already registered? Login"
        android:textColor="#17365D"
        android:padding="18dp"/>
</LinearLayout>