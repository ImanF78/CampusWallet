<!-- Root container: a vertical layout that centres the login form on the screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#F3F6FA">

    <!-- ===== HEADER SECTION ===== -->

    <!-- Screen title, centred and bold -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome Back!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"/>

    <!-- Subtitle telling returning users why they should log in; margins add space above and below -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log in to check your balance and keep your finances on track."
        android:textColor="#526174"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="25dp"/>

    <!-- ===== LOGIN FORM FIELDS ===== -->

    <!-- Input for the email address; the keyboard shows the @ symbol for easy typing -->
    <EditText
        android:id="@+id/loginEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email address"
        android:inputType="textEmailAddress"
        android:padding="14dp"/>

    <!-- Password input; characters are hidden as the user types -->
    <EditText
        android:id="@+id/loginPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="14dp"/>

    <!-- ===== ACTIONS ===== -->

    <!-- Submits the credentials to log the user in -->
    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:layout_marginTop="18dp"
        android:backgroundTint="#17365D"/>

    <!-- Link-style text for users without an account; clicking it should open the registration screen -->
    <TextView
        android:id="@+id/backToRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account? Register"
        android:textColor="#17365D"
        android:padding="18dp"/>
</LinearLayout>