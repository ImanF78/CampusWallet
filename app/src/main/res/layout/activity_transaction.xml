<!-- Root container: a vertical layout that centres the add-transaction form on the screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#F3F6FA">

    <!-- ===== HEADER SECTION ===== -->

    <!-- Screen title, centred and bold -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Transaction"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"/>

    <!-- Subtitle explaining why recording transactions matters; margins add space above and below -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record money coming in or money you spend. This helps keep your balance accurate."
        android:textColor="#526174"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"/>

    <!-- ===== TRANSACTION TYPE SELECTION ===== -->

    <!-- Label for the type buttons below -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose transaction type"
        android:textStyle="bold"
        android:textColor="#17365D"/>

    <!-- Selects the transaction as money coming in (income) -->
    <Button
        android:id="@+id/incomeOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Income"/>

    <!-- Selects the transaction as money going out (expense) -->
    <Button
        android:id="@+id/expenseOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expense"/>

    <!-- ===== TRANSACTION DETAILS ===== -->

    <!-- Input for the amount in KSh (decimal numbers only); top margin separates it from the type buttons -->
    <EditText
        android:id="@+id/transactionAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amount in KSh"
        android:inputType="numberDecimal"
        android:padding="14dp"
        android:layout_marginTop="16dp"/>

    <!-- Input for the category (for example Food or Transport); the keyboard capitalises the first letter of each sentence -->
    <EditText
        android:id="@+id/transactionCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category e.g. Food, Transport, Allowance"
        android:inputType="textCapSentences"
        android:padding="14dp"/>

    <!-- ===== ACTIONS ===== -->

    <!-- Saves the transaction with the chosen type, amount and category -->
    <Button
        android:id="@+id/submitTransaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Transaction"
        android:layout_marginTop="18dp"
        android:backgroundTint="#17365D"/>

    <!-- Link-style text that should return the user to the dashboard screen -->
    <TextView
        android:id="@+id/backToDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:textColor="#17365D"
        android:padding="18dp"/>
</LinearLayout>